@page "/product-history"
@inject AuthenticationStateProvider _authProvider
@inject NavigationManager navigation
@inject ISerAlert _msg
@inject SerProduct _serProductos
@inject SerEnvio _serEnvios
@inject ISnackbar _snackBar

<AuthorizeView>
    <Authorized>
        @if (_verListado)
        {
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-0">

                <MudGrid Justify="Justify.SpaceBetween">
                    <MudItem xs="12" sm="2">
                        <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Warning" OnClick="Regresar_onClick">
                            <MudIcon Icon="@Icons.Material.Rounded.Backspace" Size="Size.Small" Class="me-1" />
                            Regresar
                        </MudButton>
                    </MudItem>

                    <MudItem xs="12" sm="8">
                        <MudText Typo="Typo.h5" GutterBottom="true" Align="Align.Center" Color="Color.Primary">Histórico Productos</MudText>
                    </MudItem>
                </MudGrid>
                <MudItem xs="12">
                    <MudTable T="Products"
                              ServerData="LoadServerData"
                              RowsPerPage="20"
                              RowsPerPageOptions="new int[] {5, 10, 20, 50}"
                              Bordered="true"
                              Striped="true"
                              Hover="true"
                              Dense="true"
                              Breakpoint="Breakpoint.Sm"
                              Elevation="1"
                              @bind-SelectedItem="productSelected"
                              @ref="tableRef">
                        <ToolBarContent>
                            <MudSpacer />
                            <MudTextField @bind-Value="_cadenaBuscar"
                                          Placeholder="Buscar"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          IconSize="Size.Medium"
                                          Immediate="true"
                                          OnBlurred="TriggerReload"
                                          OnKeyUp="TriggerReload"
                                          Class="mt-0" />
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh>ItemID</MudTh>
                            <MudTh>ProductoName</MudTh>
                            <MudTh>UPC</MudTh>
                            <MudTh>IsActive</MudTh>
                            <MudTh>Foto</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate Context="productRow">
                            <MudTd DataLabel="ID">@productRow.ItemID</MudTd>
                            <MudTd DataLabel="Nombre">@productRow.ProductName</MudTd>
                            <MudTd DataLabel="Codigo">@productRow.UPC</MudTd>
                            <MudTd DataLabel="Uni. Medidad">
                                @if (productRow.IsActive)
                                {
                                    <span>Si</span>
                                }
                                else
                                {
                                    <span>No</span>
                                }
                            </MudTd>
                            <MudTd>
                                @if (productRow.IdImage > 0)
                                {
                                    @if (productRow.ImageData != null && productRow.ImageData.Length > 0)
                                    {
                                        <img src="data:image/png;base64,@Convert.ToBase64String(productRow.ImageData)"
                                             style="max-width:50px; border-radius:8px;" />
                                    }
                                }
                            </MudTd>
                            <MudTd>
                                <MudFab Color="Color.Tertiary"
                                        StartIcon="@Icons.Material.Filled.Bookmark"
                                        Label="Ver Historico"
                                        Size="Size.Small"
                                        OnClick="@(() => VerHistorial_onClick(productRow))" />


                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudItem>
            </MudContainer>
        }
        @if (_verHistorico)
        {
            <MudContainer MaxWidth="MaxWidth.ExtraLarge">
                <MudItem>
                    <MudButton Variant="Variant.Filled" Size="Size.Small" 
                               Style="@($"color:{Colors.Gray.Lighten1}; background:{Colors.Blue.Lighten1}")"
                    OnClick="Volver_onClick">
                        <MudIcon Icon="@Icons.Material.Rounded.Backspace" Size="Size.Small" Class="me-1" />
                        Back
                    </MudButton>
                </MudItem>


                <MudPaper Class="pa-2 ma-1 mt-1 mb-2" Square="true">
                    <MudGrid>

                        <MudItem xs="12">
                            <MudTextField Disabled @bind-Value="lsProductHistorico[0].ProductName" Label="Item ID" Variant="Variant.Outlined"></MudTextField>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField Disabled @bind-Value="lsProductHistorico[0].ItemID" Label="Item ID" Variant="Variant.Outlined"></MudTextField>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField Disabled @bind-Value="lsProductHistorico[0].UPC" Label="UPC" Variant="Variant.Outlined"></MudTextField>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField Disabled @bind-Value="lsProductHistorico[0].FechaDespacho" Label="FechaDespacho" Variant="Variant.Outlined"></MudTextField>
                        </MudItem>

                    </MudGrid>
                </MudPaper>
            </MudContainer>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-5">
                <table class="table table-bordered  table-sm">
                    <thead>
                        <tr>
                            <th>Nro</th>
                            <th>Fecha Envio</th>
                            <th>CostPrice</th>
                            <th>SalePrice</th>
                            <th>WFS</th>
                            <th>StorageFee_WFS</th>
                            <th>% Commission</th>
                            <th>Commission</th>
                            <th>PoundFee Shipment</th>
                            <th>Profit</th>
                            <th>ROI</th>
                            <th>WFS_RefFee</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (lsProductHistorico != null && lsProductHistorico.Count > 0)
                        {
                            @foreach (var item in lsProductHistorico)
                            {
                                <tr>
                                    <td>@item.Nro</td>
                                    <td>@item.FechaDespacho</td>
                                    <td>@item.CostPrice.ToString("C", new CultureInfo("en-US"))</td>
                                    <td>@item.SalePrice.ToString("C", new CultureInfo("en-US"))</td>
                                    <td>@item.WFS</td>
                                    <td>@item.StorageFee_WFS</td>
                                    <td>@item.PercentageCommission %</td>
                                    <td>@item.Commission.ToString("C", new CultureInfo("en-US"))</td>
                                    <td>@item.PoundFee_Shipment</td>
                                    <td>@item.Profit</td>
                                    <td>@item.ROI</td>
                                    <td>@item.WFS_RefFee</td>
                                </tr>

                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center">No hay datos para mostrar</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </MudContainer>
        }




    </Authorized>
    <NotAuthorized>

    </NotAuthorized>
</AuthorizeView>
